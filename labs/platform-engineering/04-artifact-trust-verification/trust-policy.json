{
  "environment": "production",
  "allowedRegistryPrefixes": [
    "registry.example.com/payments/"
  ],
  "certificateIssuer": "https://token.actions.githubusercontent.com",
  "certificateIdentityRegex": "^https://github\\.com/example/payments/\\.github/workflows/release\\.yaml@refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "requireTransparencyVerification": true,
  "provenancePredicateType": "https://slsa.dev/provenance/v1",
  "sourceRepository": "https://github.com/example/payments",
  "sourceRefRegex": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "approvedBuilderIds": [
    "https://github.com/actions/runner-images/github-hosted"
  ],
  "approvedWorkflow": ".github/workflows/release.yaml",
  "approvedBuildTypes": [
    "https://github.com/example/platform/buildtypes/container/v1"
  ],
  "requiredSbomFormats": [
    "spdx-json",
    "cyclonedx-json"
  ],
  "maxScanAgeHours": 24,
  "maximumCriticalVulnerabilities": 0,
  "maximumHighVulnerabilities": 5,
  "requireReleaseAuthorization": true
}
