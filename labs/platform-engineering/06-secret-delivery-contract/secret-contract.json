{
  "service": {
    "name": "payments-api",
    "owner": "team-payments",
    "environment": "production",
    "namespace": "payments-prod",
    "serviceAccount": "payments-api"
  },
  "authority": {
    "system": "external-secret-manager",
    "authoritative": true,
    "region": "us-east-1",
    "remotePath": "teams/payments/prod/database",
    "allowedPathPrefix": "teams/payments/prod/",
    "credentialType": "rotated-static",
    "rotationPeriodHours": 168,
    "overlapHours": 24
  },
  "providerAuthentication": {
    "method": "workload-identity",
    "staticCredentialUsed": false,
    "trustedNamespace": "payments-prod",
    "trustedServiceAccount": "payments-api",
    "audience": "secrets.platform.example.com",
    "maximumTokenTtlMinutes": 60
  },
  "delivery": {
    "mechanism": "operator-sync",
    "storeScope": "Namespace",
    "storeNamespace": "payments-prod",
    "allowedNamespaces": [
      "payments-prod"
    ],
    "targetKind": "KubernetesSecret",
    "targetName": "payments-api-database",
    "targetIsAuthority": false,
    "refreshPolicy": "Periodic",
    "refreshIntervalMinutes": 30,
    "deletionPolicy": "Retain",
    "creationPolicy": "Owner"
  },
  "application": {
    "consumption": "mounted-file",
    "reloadMethod": "signal-and-reopen",
    "confirmsDeliveredVersion": true,
    "startupTimeoutSeconds": 120,
    "livenessDependsOnProvider": false,
    "readinessRequiresUsableCredential": true
  },
  "outage": {
    "existingWorkloadsMayUseValidCache": true,
    "newPodsMayUseStaleCache": false,
    "maximumStaleMinutes": 0,
    "boundedRetry": true,
    "expiryMarginAlertMinutes": 120
  },
  "audit": {
    "secretReadsAudited": true,
    "policyChangesAudited": true,
    "rotationEventsAudited": true,
    "valueRedactionRequired": true
  }
}
